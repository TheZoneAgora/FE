# Sui `agent_market` package (Testnet). Defaults to the deployed address if unset.
NEXT_PUBLIC_AGENT_MARKET_PACKAGE_ID=0x0f5a55d4768a22382295652b415c0df973db45e4ac1d65c8ceadc3a331c68bfa

# Required for real mode — the AgoraAgent operator address.
NEXT_PUBLIC_AGORA_AGENT_OPERATOR=

# Required for real mode — the testnet USDC (fiat) coin type.
NEXT_PUBLIC_AGORA_FIAT_COIN_TYPE=

# Crypto leg coin type. Defaults to native SUI.
NEXT_PUBLIC_AGORA_CRYPTO_COIN_TYPE=0x2::sui::SUI

# "mock" | "real". Falls back to "mock" unless both operator and fiat coin type are set.
NEXT_PUBLIC_VAULT_MODE=mock
